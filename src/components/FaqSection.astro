---
import { faqData } from '../data/faq';

interface Props {
  limit?: number;
  showTitle?: boolean;
}

const { limit, showTitle = true } = Astro.props;

const itemsToDisplay = limit ? faqData.slice(0, limit) : faqData;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': itemsToDisplay.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};
---

<section class="faq-section" id="faq-section">
  <div class="container">
    {showTitle && (
      <div class="section-header">
        <span class="badge badge-purple mb-3">常见疑问解答</span>
        <h2>FlyingBird 常见问题 FAQ</h2>
        <p>整理关于套餐选择、流量计算、节点连接与客户端排查的常见解答。</p>
      </div>
    )}

    <div class="faq-grid">
      {itemsToDisplay.map((item) => (
        <article class="faq-card skyline-card" id={item.id}>
          <div class="faq-header">
            <span class="faq-cat-badge">{item.category}</span>
            <h3 class="faq-question">{item.question}</h3>
          </div>
          <div class="faq-answer-box">
            <p class="faq-answer">{item.answer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    padding: 5rem 0;
    background-color: var(--color-dawn-white);
  }

  .mb-3 {
    margin-bottom: 0.75rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .faq-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid rgba(37, 51, 74, 0.08);
    box-shadow: var(--shadow-sm);
  }

  .faq-cat-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-twilight-purple);
    background: rgba(132, 91, 157, 0.08);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .faq-question {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-deep-indigo);
    line-height: 1.4;
    margin-bottom: 1rem;
  }

  .faq-answer {
    font-size: 0.95rem;
    color: #4A5568;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
