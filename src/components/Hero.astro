---
import { AFFILIATE_URL } from '../data/plans';
---

<section class="hero-skyline">
  <div class="container hero-inner">
    <!-- Left Content -->
    <div class="hero-content">
      <div class="hero-badge badge">
        <span class="badge-dot"></span>
        FLYINGBIRD SKYLINE 视觉全新升级
      </div>

      <h1 class="hero-title">
        FlyingBird<br />
        <span class="text-gradient">轻盈连接每一段数字旅程</span>
      </h1>

      <p class="hero-subtitle">
        探索 FlyingBird 套餐价格、流量方案与使用指南，了解不同使用习惯下的网络连接知识。
      </p>

      <div class="hero-actions">
        <a href="/plans/" class="btn btn-primary hero-btn">
          探索套餐
        </a>
        <a href="/guide/" class="btn btn-outline hero-btn">
          使用指南
        </a>
        <a 
          href={AFFILIATE_URL} 
          target="_blank" 
          rel="sponsored nofollow noopener" 
          class="btn btn-commercial hero-btn"
        >
          立即注册
        </a>
      </div>

      <div class="hero-highlights">
        <div class="highlight-item">
          <span class="highlight-num">1000M</span>
          <span class="highlight-label">高速带宽峰值</span>
        </div>
        <div class="highlight-divider"></div>
        <div class="highlight-item">
          <span class="highlight-num">优化线路</span>
          <span class="highlight-label">中国大陆方向支持</span>
        </div>
        <div class="highlight-divider"></div>
        <div class="highlight-item">
          <span class="highlight-num">双轨方案</span>
          <span class="highlight-label">月付与一次性流量包</span>
        </div>
      </div>
    </div>

    <!-- Right Skyline Illustration -->
    <div class="hero-visual">
      <div class="skyline-art-card">
        <svg class="hero-svg" viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="240" cy="200" r="160" fill="url(#sun-gradient)" opacity="0.4" />
          <path d="M40 280 Q 140 220 240 260 T 440 240 L 440 360 L 40 360 Z" fill="url(#wave-gradient-1)" opacity="0.6" />
          <path d="M40 310 Q 180 250 280 290 T 440 270 L 440 360 L 40 360 Z" fill="url(#wave-gradient-2)" opacity="0.8" />
          
          <!-- Original Flying Birds Silhouettes -->
          <path d="M120 130 Q130 120 140 130 Q150 115 160 125 Q145 135 120 130Z" fill="#845B9D" opacity="0.85" />
          <path d="M220 90 Q235 78 250 90 Q265 72 280 85 Q260 98 220 90Z" fill="#E88A66" opacity="0.9" />
          <path d="M310 140 Q320 132 330 140 Q340 128 350 136 Q335 145 310 140Z" fill="#25334A" opacity="0.85" />
          <path d="M180 180 Q190 172 200 180 Q210 168 220 176 Q205 185 180 180Z" fill="#A7CEC8" opacity="0.9" />

          <defs>
            <radialGradient id="sun-gradient" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(240 200) rotate(90) scale(160)">
              <stop stop-color="#E88A66" stop-opacity="0.8"/>
              <stop offset="0.6" stop-color="#845B9D" stop-opacity="0.4"/>
              <stop offset="1" stop-color="#FBF7EF" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="wave-gradient-1" x1="40" y1="220" x2="440" y2="360" gradientUnits="userSpaceOnUse">
              <stop stop-color="#845B9D" stop-opacity="0.3"/>
              <stop offset="1" stop-color="#A7CEC8" stop-opacity="0.1"/>
            </linearGradient>
            <linearGradient id="wave-gradient-2" x1="40" y1="250" x2="440" y2="360" gradientUnits="userSpaceOnUse">
              <stop stop-color="#25334A" stop-opacity="0.15"/>
              <stop offset="1" stop-color="#845B9D" stop-opacity="0.25"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-skyline {
    background: var(--skyline-hero-gradient);
    padding: 4.5rem 0 5rem 0;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(132, 91, 157, 0.08);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-badge {
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-sunset-orange);
    display: inline-block;
  }

  .hero-title {
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.65;
    color: #4A5568;
    margin-bottom: 2.25rem;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .hero-btn {
    padding: 0.85rem 1.85rem;
    font-size: 1.05rem;
  }

  .hero-highlights {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 1.25rem 1.75rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    width: fit-content;
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
  }

  .highlight-num {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-deep-indigo);
  }

  .highlight-label {
    font-size: 0.8125rem;
    color: #718096;
    font-weight: 500;
  }

  .highlight-divider {
    width: 1px;
    height: 32px;
    background: rgba(37, 51, 74, 0.12);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .skyline-art-card {
    width: 100%;
    max-width: 480px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(251, 247, 239, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1rem;
  }

  .hero-svg {
    width: 100%;
    height: auto;
  }

  @media (max-width: 1024px) {
    .hero-title {
      font-size: 2.75rem;
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-highlights {
      margin: 0 auto;
    }

    .hero-visual {
      order: -1;
    }

    .skyline-art-card {
      max-width: 380px;
      margin: 0 auto;
    }
  }

  @media (max-width: 540px) {
    .hero-title {
      font-size: 2.25rem;
    }

    .hero-highlights {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }

    .highlight-divider {
      width: 100%;
      height: 1px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-btn {
      width: 100%;
    }
  }
</style>
