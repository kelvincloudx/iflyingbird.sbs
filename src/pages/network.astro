---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { regions, networkTopics } from '../data/nodes';
import { AFFILIATE_URL } from '../data/plans';
---

<Layout 
  title="FlyingBird 网络知识科普｜节点地区、延迟检测与带宽吞吐解析"
  description="探索FlyingBird网络连接知识，深入了解香港、日本、美国、德国优化节点特性，以及延迟、丢包与1000M带宽在日常使用中的表现。"
  canonicalPath="/network/"
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: '网络知识' }]} />
      <h1>FlyingBird 网络连接与节点知识专区</h1>
      <p>
        深入理解物理延迟、骨干网路由收敛、中国大陆优化线路及 1000M 带宽吞吐背后的技术逻辑。
      </p>
    </div>
  </div>

  <section class="network-section">
    <div class="container">
      <!-- Section 1: Region Nodes Knowledge -->
      <div class="block-header">
        <span class="badge badge-purple mb-2">公开节点地区</span>
        <h2>重点节点地区线路特性解析</h2>
        <p>基于 FlyingBird 公开数据展示的香港、日本、美国与德国四大核心节点集群。</p>
      </div>

      <div class="regions-detail-grid">
        {regions.map((r) => (
          <div class="region-detail-card skyline-card">
            <div class="card-header">
              <span class="flag-icon">{r.flag}</span>
              <div>
                <h3>{r.name}</h3>
                <span class="code-badge">{r.code} Region</span>
              </div>
            </div>
            <div class="card-body">
              <p><strong>线路架构与优化：</strong>{r.features}</p>
              <p><strong>最佳推荐场景：</strong>{r.recommendedFor}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Section 2: Core Network Topics -->
      <div class="block-header mt-5">
        <span class="badge mb-2">通用技术科普</span>
        <h2>影响网络连接体验的七大要素</h2>
        <p>从物理距离到客户端代理分流，全面剖析影响跨国访问速度与稳定性因素。</p>
      </div>

      <div class="topics-grid">
        {networkTopics.map((topic, idx) => (
          <div class="topic-card skyline-card">
            <div class="topic-num">0{idx + 1}</div>
            <h3>{topic.title}</h3>
            <p>{topic.desc}</p>
          </div>
        ))}
      </div>

      <!-- Related deep dive articles -->
      <div class="network-articles-callout skyline-card">
        <h3>深入阅读精选技术文章</h3>
        <div class="callout-grid">
          <a href="/stories/session-continuity/" class="callout-item">
            <h4>视频会议与网页会话中断原因解析 &rarr;</h4>
            <p>探索网络抖动、本地 IP 切换与系统休眠对长连接连续性的深刻影响。</p>
          </a>
          <a href="/stories/node-checks/" class="callout-item">
            <h4>怎样正确理解节点连接测试结果？ &rarr;</h4>
            <p>解析 Ping 延迟、丢包率与 1000M 带宽吞吐的区别，避开单次测速误区。</p>
          </a>
        </div>
      </div>

      <!-- Commercial CTA -->
      <div class="network-cta text-center">
        <h3>准备好体验 FlyingBird 优化线路了吗？</h3>
        <p class="mb-3">探索符合您用量规律的月付套餐与不限时流量包。</p>
        <a href={AFFILIATE_URL} target="_blank" rel="sponsored nofollow noopener" class="btn btn-commercial">
          查看套餐方案并订阅
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mb-2 { margin-bottom: 0.5rem; }
  .mb-3 { margin-bottom: 1.25rem; }
  .mt-5 { margin-top: 4.5rem; }
  .text-center { text-align: center; }

  .network-section {
    padding: 4rem 0;
    background-color: var(--color-dawn-white);
  }

  .block-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem auto;
  }

  .block-header h2 {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
  }

  .block-header p {
    color: #718096;
    font-size: 1rem;
  }

  .regions-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .region-detail-card {
    padding: 2rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(37, 51, 74, 0.08);
  }

  .flag-icon {
    font-size: 2.25rem;
  }

  .card-header h3 {
    font-size: 1.25rem;
  }

  .code-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-twilight-purple);
    background: rgba(132, 91, 157, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .card-body p {
    font-size: 0.925rem;
    color: #4A5568;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  /* Topics grid */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .topic-card {
    padding: 1.75rem;
    position: relative;
  }

  .topic-num {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-sunset-orange);
    background: rgba(232, 138, 102, 0.12);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .topic-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
  }

  .topic-card p {
    font-size: 0.9rem;
    color: #4A5568;
    line-height: 1.6;
  }

  /* Articles callout */
  .network-articles-callout {
    margin-top: 4.5rem;
    background: #ffffff;
    border: 1px solid rgba(132, 91, 157, 0.2);
  }

  .network-articles-callout h3 {
    font-size: 1.35rem;
    margin-bottom: 1.5rem;
  }

  .callout-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .callout-item {
    display: block;
    background: var(--color-dawn-white);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(37, 51, 74, 0.08);
  }

  .callout-item:hover {
    border-color: var(--color-sunset-orange);
  }

  .callout-item h4 {
    font-size: 1.05rem;
    color: var(--color-deep-indigo);
    margin-bottom: 0.4rem;
  }

  .callout-item p {
    font-size: 0.875rem;
    color: #718096;
    line-height: 1.5;
  }

  .network-cta {
    margin-top: 4.5rem;
    padding: 3rem;
    background: var(--skyline-card-gradient);
    border: 1px solid rgba(37, 51, 74, 0.1);
    border-radius: var(--radius-lg);
  }

  .network-cta h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .network-cta p {
    color: #718096;
  }

  @media (max-width: 1024px) {
    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .regions-detail-grid, .topics-grid, .callout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
