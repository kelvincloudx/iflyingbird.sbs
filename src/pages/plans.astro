---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlanCard from '../components/PlanCard.astro';
import { plans, AFFILIATE_URL } from '../data/plans';
---

<Layout 
  title="FlyingBird 飞鸟机场套餐价格表｜月付300GB与一次性流量包方案"
  description="查看FlyingBird公开参考套餐选型，包含¥15/月300GB按月重置套餐、¥25/次300GB与¥60/次1000GB不限时流量包，对比价格与使用场景。"
  canonicalPath="/plans/"
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: '套餐方案' }]} />
      <h1>FlyingBird 双轨套餐价格全览</h1>
      <p>
        遵循公开参考标准，为您清晰展示 FlyingBird 的月付订阅与一次性流量包组合。无隐形扣费，流量规则公开透明。
      </p>
    </div>
  </div>

  <section class="plans-main-section">
    <div class="container">
      <!-- 3-Column Parallel Grid [ 1 - 2 - 3 ] -->
      <div class="plans-header-block">
        <span class="badge badge-purple mb-2">双轨套餐对比</span>
        <h2>三大参考套餐横向并列展示</h2>
        <p>左侧为月度按月循环刷新方案；右侧为一次性购买、流量不过期的备用流量包方案。</p>
      </div>

      <div class="plans-grid-3col">
        {plans.map((plan) => (
          <PlanCard 
            plan={plan} 
            ctaText={plan.type === 'monthly' ? '立即开通月付套餐' : '立即购买流量包'} 
          />
        ))}
      </div>

      <!-- Plan Comparison Table -->
      <div class="comparison-section">
        <h2 class="comp-title">三大参考套餐规则细节对比</h2>
        <div class="table-responsive">
          <table class="comp-table">
            <thead>
              <tr>
                <th>套餐名称</th>
                <th>参考价格</th>
                <th>流量额度</th>
                <th>付费类型</th>
                <th>流量刷新规则</th>
                <th>最高带宽</th>
                <th>推荐适用人群</th>
                <th>购买入口</th>
              </tr>
            </thead>
            <tbody>
              {plans.map((p) => (
                <tr>
                  <td class="font-bold">{p.name}</td>
                  <td class="price-cell">¥{p.price}</td>
                  <td>{p.traffic}</td>
                  <td>{p.type === 'monthly' ? '月度订阅' : '一次性购买'}</td>
                  <td>{p.cycle}</td>
                  <td>1000M 峰值</td>
                  <td>{p.type === 'monthly' ? '高频日常办公、流媒体观看' : (p.priceNum > 30 ? '长期大流量下载、多设备备用' : '轻度网页查阅、临时跨国连接')}</td>
                  <td>
                    <a href={AFFILIATE_URL} target="_blank" rel="sponsored nofollow noopener" class="table-btn">
                      立即订阅
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Notice Box -->
      <div class="plans-notice skyline-card">
        <h3>订阅购买与使用须知</h3>
        <ul>
          <li><strong>商业关系披露：</strong>本站所列按钮均跳转至 FlyingBird 唯一指定商业注册购买链接（https://varnexa.lingdongaff.com/#/?code=HHoxxHGa）。</li>
          <li><strong>带宽与线路说明：</strong>1000M 峰值带宽与优化线路均引自公开参考数据，实际传输速度受本地宽带、设备性能及目标网站服务器响应影响。</li>
          <li><strong>流量重置时间：</strong>月付套餐以购买日为账单周期起始点；一次性流量包在账户正常状态下持续扣减直至归零。</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mb-2 {
    margin-bottom: 0.5rem;
  }

  .plans-main-section {
    padding: 4rem 0;
    background-color: var(--color-dawn-white);
  }

  .plans-header-block {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem auto;
  }

  .plans-header-block h2 {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
  }

  .plans-header-block p {
    color: #718096;
    font-size: 1rem;
  }

  /* 3-Column Parallel Grid [ 1 - 2 - 3 ] */
  .plans-grid-3col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-bottom: 4rem;
    align-items: stretch;
  }

  /* Comparison table */
  .comparison-section {
    margin-top: 4rem;
  }

  .comp-title {
    font-size: 1.75rem;
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .table-responsive {
    overflow-x: auto;
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid rgba(37, 51, 74, 0.1);
    box-shadow: var(--shadow-sm);
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.925rem;
  }

  .comp-table th, .comp-table td {
    padding: 1.15rem 1rem;
    border-bottom: 1px solid rgba(37, 51, 74, 0.08);
  }

  .comp-table th {
    background: #F8F6F0;
    color: var(--color-deep-indigo);
    font-weight: 700;
  }

  .font-bold {
    font-weight: 700;
    color: var(--color-deep-indigo);
  }

  .price-cell {
    font-weight: 800;
    color: var(--color-sunset-orange);
    font-size: 1.05rem;
  }

  .table-btn {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    font-size: 0.825rem;
    font-weight: 600;
    background: var(--skyline-commercial-gradient);
    color: #ffffff;
    border-radius: var(--radius-full);
  }

  .table-btn:hover {
    opacity: 0.9;
    color: #ffffff;
  }

  /* Notice Box */
  .plans-notice {
    margin-top: 4rem;
    background: #ffffff;
    border-left: 4px solid var(--color-twilight-purple);
  }

  .plans-notice h3 {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .plans-notice ul {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: #4A5568;
    font-size: 0.925rem;
  }

  @media (max-width: 1024px) {
    .plans-grid-3col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .plans-grid-3col {
      grid-template-columns: 1fr;
    }
  }
</style>
